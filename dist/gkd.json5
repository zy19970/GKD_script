{
  id: 1400965095,
  name: 'zy19970 的 GKD 规则',
  version: 4,
  author: 'zy19970',
  updateUrl:
    'https://fastly.jsdelivr.net/gh/zy19970/GKD_script@main/dist/gkd.json5',
  checkUpdateUrl:
    'https://fastly.jsdelivr.net/gh/zy19970/GKD_script@main/dist/gkd.version.json5',
  supportUri: 'https://github.com/zy19970/GKD_script',
  categories: [],
  globalGroups: [],
  apps: [
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 10001,
          name: '功能类-自动上滑继续观看短剧',
          desc: '检测到“上滑继续观看短剧”后自动上滑',
          activityIds:
            'com.ss.android.ugc.aweme.playlet.videodetail.PlayletVideoPlayActivity',
          matchRoot: true,
          rules: [
            {
              key: 0,
              matches:
                '[text="上滑继续观看短剧"][visibleToUser=true]',
              action: 'swipe',
              actionCd: 3000,
              swipeArg: {
                start: {
                  x: 'screenWidth * 0.50',
                  y: 'screenHeight * 0.72',
                },
                end: {
                  x: 'screenWidth * 0.50',
                  y: 'screenHeight * 0.28',
                },
                duration: 300,
              },
            },
          ],
        },
      ],
    },
    {
      id: 'com.sgcc.wsgw.cn',
      name: '网上国网',
      groups: [
        {
          key: 10001,
          name: '功能类-自动签到',
          desc: '在首页检测到“签到”入口后自动点击',
          activityIds:
            'com.sgcc.wsgw.rnbundle.activity.HomeReactActivity',
          matchRoot: true,
          actionMaximum: 1,
          rules: [
            {
              key: 0,
              fastQuery: true,
              matches:
                'ViewGroup[desc="签到"][focusable=true][visibleToUser=true]',
              action: 'clickCenter',
            },
          ],
        },
      ],
    },
    {
      id: 'com.kuaishou.nebula',
      name: '快手极速版',
      groups: [
        {
          key: 10001,
          name: '功能类-自动上滑继续观看短剧',
          desc: '检测到“上滑继续观看短剧”后自动上滑',
          activityIds:
            'com.yxcorp.gifshow.detail.PhotoDetailActivity',
          matchRoot: true,
          rules: [
            {
              key: 0,
              matches:
                '[vid="tube_slide_limit_bottom_bar_text"][text="上滑继续观看短剧"][visibleToUser=true]',
              action: 'swipe',
              actionCd: 3000,
              swipeArg: {
                start: {
                  x: 'screenWidth * 0.50',
                  y: 'screenHeight * 0.72',
                },
                end: {
                  x: 'screenWidth * 0.50',
                  y: 'screenHeight * 0.28',
                },
                duration: 300,
              },
            },
          ],
        },
      ],
    },
  ],
}
